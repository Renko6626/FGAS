AUTH_MODE=development
DATABASE_URL=postgresql+psycopg2://fgas:change-me@127.0.0.1:5432/fgas
INITIAL_ADMIN_ID=admin
INITIAL_ADMIN_NAME=管理员
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
API_PORT=8000

# Formal deployments use Casdoor instead of the development account picker.
# Keep these in the server .env, never in the repository:
# AUTH_MODE=casdoor
# CASDOOR_ISSUER=https://auth.fantasyguide.cn
# CASDOOR_CLIENT_ID=
# CASDOOR_CLIENT_SECRET=
# CASDOOR_REDIRECT_URI=https://fgas.example.com/api/auth/casdoor/callback
# CASDOOR_SCOPE=openid profile email
# INITIAL_ADMIN_SUBJECT=
# INITIAL_ADMIN_NAME=管理员
