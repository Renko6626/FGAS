# Coolify environment variables for deploy/compose.coolify.yaml.
# Set these in the resource's Environment Variables tab; mark the secrets as
# Secret/Locked there. Never commit real values.

# Immutable ACR image tags. Use a new version for every release.
FGAS_API_IMAGE=crpi-bug4nt14ryr5n8sw.cn-beijing.personal.cr.aliyuncs.com/renko/fgas-api:CHANGE_ME
FGAS_WEB_IMAGE=crpi-bug4nt14ryr5n8sw.cn-beijing.personal.cr.aliyuncs.com/renko/fgas:CHANGE_ME

# Optional. Set this if Docker Hub is unreachable and postgres:17 is mirrored
# to ACR instead.
# FGAS_DB_IMAGE=crpi-bug4nt14ryr5n8sw.cn-beijing.personal.cr.aliyuncs.com/renko/postgres:17

# Hexadecimal only: it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=

AUTH_MODE=casdoor
CASDOOR_ISSUER=https://auth.fantasyguide.cn
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_REDIRECT_URI=https://fgas.secret-sealing.club/api/auth/casdoor/callback
CASDOOR_SCOPE=openid profile email
INITIAL_ADMIN_SUBJECT=
INITIAL_ADMIN_NAME=管理员
SESSION_TTL_HOURS=168
COOKIE_SECURE=true
