# 按实际部署调整 User/Group、WorkingDirectory 和 EnvironmentFile。
[Unit]
Description=FGAS database backup (pg_dump)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=fgas
Group=fgas
WorkingDirectory=/srv/fgas
EnvironmentFile=/srv/fgas/.env
StateDirectory=fgas-backup
StateDirectoryMode=0700
ExecStart=/srv/fgas/scripts/backup-db.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
