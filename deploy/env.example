# Generate once with: openssl rand -hex 24
# Use hexadecimal characters so the value is also safe in DATABASE_URL.
POSTGRES_PASSWORD=

# development keeps the account picker for local trials.
# casdoor is required for formal deployments.
AUTH_MODE=casdoor

# Casdoor application settings. Create a dedicated FGAS application in
# Casdoor; do not reuse personal administrator keys or the CASDOOR_KEY /
# CASDOOR_SECRET values used by other tools.
# CASDOOR_REDIRECT_URI must exactly match the callback registered in Casdoor,
# for example https://fgas.example.com/api/auth/casdoor/callback.
CASDOOR_ISSUER=https://auth.fantasyguide.cn
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_REDIRECT_URI=
# Optional; this is the space-separated OIDC scope. The default is shown.
# CASDOOR_SCOPE=openid profile email

# The first casdoor login whose Casdoor sub or username equals this value
# becomes the initial administrator. Prefer copying the exact sub from
# Casdoor; username matching is weaker. Later role changes stay local.
INITIAL_ADMIN_SUBJECT=
# Fallback display name only when Casdoor returns none.
INITIAL_ADMIN_NAME=管理员

# Absolute web-session lifetime. Default 168 hours.
# SESSION_TTL_HOURS=168
# Must be true whenever the site is served over HTTPS.
COOKIE_SECURE=false

# Enable the webpage assistant. Administrators configure its shared Key in the UI.
# Coolify enables it by default; standalone Compose keeps this opt-in.
FGAS_WEB_AGENT_PROTOTYPE=0
# Optional fallback when no shared Key is saved in the database:
# FGAS_DEEPSEEK_API_KEY=

# Development overrides (ignored in casdoor mode).
INITIAL_ADMIN_ID=admin

FGAS_BIND_HOST=127.0.0.1
FGAS_HTTP_PORT=8080
